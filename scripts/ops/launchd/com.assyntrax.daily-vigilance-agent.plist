<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.assyntrax.daily-vigilance-agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>scripts/ops/run_daily_vigilance_agent.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_PATH__</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__REPO_PATH__/results/ops/agents/logs/daily_vigilance_agent.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_PATH__/results/ops/agents/logs/daily_vigilance_agent.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
