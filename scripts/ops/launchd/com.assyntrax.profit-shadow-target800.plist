<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.assyntrax.profit-shadow-target800</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>scripts/ops/run_profit_shadow_target_800_overnight.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_PATH__</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__REPO_PATH__/results/ops/profit_shadow_target_800/logs/overnight.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_PATH__/results/ops/profit_shadow_target_800/logs/overnight.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
