{
  "version": "2026.03.live.v1",
  "purpose": "semi_automatic_small_account_execution",
  "live_architecture": {
    "core": {
      "candidate_id": "champion_profit_lock_partial",
      "alias": "Athena",
      "label": "Core serio"
    },
    "guard": {
      "candidate_id": "meta_dd_combo__conv25_vol25",
      "alias": "Hestia",
      "label": "Guard de drawdown"
    },
    "attack": {
      "candidate_id": "all_assets__lb021__rb07__k2__mom_total__ama000__mma000__riskon",
      "alias": "Ares",
      "label": "Ataque rapido"
    }
  },
  "shadow_modes": [
    {
      "candidate_id": "criticality_free_energy_attack",
      "alias": "Apollo",
      "label": "Anchor estrutural"
    },
    {
      "candidate_id": "meta_mode_selector",
      "alias": "Zeus",
      "label": "Seletor de contexto"
    },
    {
      "candidate_id": "all_assets__lb126__rb07__k2__mom_total__ama200__mma200__riskon",
      "alias": "Hephaestus",
      "label": "Ataque alternativo lento"
    },
    {
      "candidate_id": "all_assets__lb021__rb07__k3__mom_vol_adj__ama000__mma000__relshy",
      "alias": "Hermes",
      "label": "Turbo shadow"
    }
  ],
  "execution_profile": {
    "profile_id": "small_account_crypto",
    "base_currency": "BRL",
    "allowed_tickers": [
      "BTC-USD",
      "ETH-USD",
      "SOL-USD"
    ],
    "cash_ticker": "CASH-BRL",
    "min_account_nav_brl": 200.0,
    "min_order_brl": 40.0,
    "min_position_brl": 80.0,
    "min_actionable_gross_exposure": 0.15,
    "min_two_asset_risk_brl": 180.0,
    "max_assets": 2,
    "core_proxy_weights": {
      "BTC-USD": 0.85,
      "ETH-USD": 0.15
    },
    "attack_proxy_weights": {
      "BTC-USD": 0.7,
      "ETH-USD": 0.3
    },
    "guard_proxy_weights": {
      "CASH-BRL": 1.0
    }
  },
  "selection_rules": {
    "attack_min_confidence_score": 0.62,
    "attack_min_gross_exposure": 0.3,
    "core_floor_gross_exposure": 0.2,
    "core_max_gross_exposure": 0.45,
    "attack_max_gross_exposure": 0.8
  },
  "risk_guardrails": {
    "max_gross_exposure": 0.8,
    "max_assets": 2,
    "max_turnover_fraction_of_nav": 0.65,
    "block_new_attack_vigilance_statuses": [
      "warn",
      "fail"
    ],
    "block_new_attack_when_confidence_below": 0.55,
    "force_cash_when_recommended_mode": "proteção"
  },
  "paths": {
    "portfolio_state_json": "data/live_execution/portfolio_state.json",
    "execution_report_json": "data/live_execution/execution_report.json",
    "shadow_watchlist_json": "config/live_shadow_watchlist.json"
  },
  "broker_adapter": {
    "name": "mercado_bitcoin",
    "mode": "manual_assisted",
    "sync_account_before_planning": true,
    "submit_enabled": false,
    "base_url": "https://api.mercadobitcoin.net",
    "quote_currency": "BRL",
    "supported_pairs": {
      "BTC-USD": "BTC-BRL",
      "ETH-USD": "ETH-BRL",
      "SOL-USD": "SOL-BRL"
    },
    "default_order_type": "market",
    "auth": {
      "base_url": "https://api.mercadobitcoin.net",
      "authorize_endpoint": "/api/v4/authorize/",
      "env": {
        "api_key": "MB_API_KEY",
        "password": "MB_API_PASSWORD"
      },
      "account_id_env": "MB_ACCOUNT_ID",
      "payload_fields": {
        "api_key": "api_key",
        "password": "password"
      },
      "token_paths": [
        "access_token",
        "token",
        "data.access_token",
        "data.token"
      ],
      "timeout_sec": 20
    },
    "private_endpoints": {
      "accounts_endpoint": "/api/v4/accounts/",
      "balances_endpoint_template": "/api/v4/accounts/{account_id}/balances/",
      "market_orders_endpoint_template": "/api/v4/accounts/{account_id}/{market}/orders/",
      "timeout_sec": 20
    },
    "public_market_data": {
      "base_url": "https://api.mercadobitcoin.net",
      "orderbook_endpoint_template": "/api/v4/{market}/orderbook/",
      "timeout_sec": 10
    },
    "order_fields": {
      "client_order_id_field": "external_id",
      "side_field": "side",
      "type_field": "type",
      "quantity_field": "quantity",
      "notional_field": "cost",
      "prefer_notional_for_buy": true
    },
    "paths": {
      "latest_preview_json": "results/ops/execution_live/latest_mercado_bitcoin_order_preview.json",
      "latest_preview_csv": "results/ops/execution_live/latest_mercado_bitcoin_order_preview.csv",
      "latest_account_snapshot_json": "results/ops/execution_live/latest_mercado_bitcoin_account_snapshot.json",
      "latest_submit_json": "results/ops/execution_live/latest_mercado_bitcoin_submit.json",
      "latest_submit_csv": "results/ops/execution_live/latest_mercado_bitcoin_submit.csv"
    }
  },
  "notes": [
    "A primeira versao live simplifica a execucao real para poucos ativos liquidos, mesmo quando o motor observa um universo bem maior.",
    "Core, guard e attack ficam congelados para reduzir complexidade operacional; o resto permanece em shadow.",
    "O modo attack real usa um proxy executavel em BTC e ETH para conta pequena, em vez de tentar replicar literalmente todo o universo do laboratorio.",
    "A sincronizacao de conta real da Mercado Bitcoin roda antes do planejamento quando as credenciais existem; sem credenciais o fluxo cai para o portfolio_state local.",
    "O envio de ordens fica bloqueado por default e so deve ser liberado via submit manual assistido com confirmacao explicita."
  ]
}
